// home/niri/config.kdl — the compositor config, plain KDL and tracked
// (out-of-store symlink from ~/.config/niri/config.kdl, home/niri.nix).
// niri WATCHES this file and every include: save = applied, no rebuild, no
// reload command. Check with `niri validate` before logging out if unsure.
//
// This file is niri 26.04's STOCK default config with a small set of
// deviations, each marked "DEVIATION" — the point of this round (unlike the
// hand-tuned hyprland era) is to learn niri's own defaults, so anything not
// marked is upstream's. Stock binds live at the bottom; Mod+Shift+/ shows
// the hotkey overlay.
//
// Include gotchas: includes are POSITIONAL and merge last-wins, and a
// missing non-optional include fails the WHOLE config (see the fragment
// block at the bottom for why that one is a fresh-install deadlock).
// Relative paths resolve against the directory of the file AS NIRI OPENED
// IT — ~/.config/niri/ — niri does NOT resolve this file's symlink back to
// ~/nix-config/home/niri/ first (measured: `include "dms/layout.kdl"`
// loads, and no dms/ dir exists in the repo). The ~ paths below are still
// the clearer spelling for our own files; DMS's three fragments keep the
// bare relative form because DMS greps for that literal string.

// Cursor theme/size, generated by Nix from home.pointerCursor
// (home/niri.nix) — niri reads the cursor from config, not XCURSOR_* env.
include "~/.config/niri/nix.kdl"

// Input device configuration.
// Find the full list of options on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // DEVIATION: two layouts, toggled by the Ctrl+Space bind below
            // (niri's own switch-layout action — deliberately NO grp:
            // option here: xkb-level switching and the niri bind on the
            // same key would double-switch and cancel out).
            layout "us,th"
        }

        // Enable numlock on startup, omitting this setting disables it.
        numlock
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    touchpad {
        tap
        natural-scroll
    }

    mouse {
        // DEVIATION: natural scrolling everywhere, not just the touchpad —
        // carried through every compositor era.
        natural-scroll
    }

    trackpoint {
        // DEVIATION: same.
        natural-scroll
    }
}

// No `output` blocks anywhere in this file, and no per-host include either:
// display layout is DMS's, set in its Settings GUI (SUPER+Shift+comma →
// Displays) and written to ~/.config/niri/dms/outputs.kdl, which the LAST
// include at the bottom pulls in. That file is machine-local and untracked
// on purpose — mode/scale/position are facts about the panels plugged into
// THIS machine, they were never reproducible config, and the tracked
// per-host files this replaced rotted exactly as you'd expect (one output
// name was off by a comma for weeks, silently leaving a 4K120 panel on its
// 60 Hz preferred mode). Cost of the trade: a fresh install boots on niri's
// auto-config until someone does one pass through the Displays GUI.

// Settings that influence how windows are positioned and sized — STOCK.
// (The focus-ring/border colors here are the pre-first-wallpaper fallback:
// the dms/colors.kdl include at the BOTTOM of this file re-themes them from
// the wallpaper palette, winning by position — includes merge last-wins.)
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Layout
layout {
    // Set gaps around windows in logical pixels.
    gaps 16

    // When to center a column when changing focus, options are:
    // - "never", default behavior, focusing an off-screen column will keep at the left
    //   or right edge of the screen.
    // - "always", the focused column will always be centered.
    // - "on-overflow", focusing a column will center it if it doesn't fit
    //   together with the previously focused column.
    center-focused-column "never"

    // You can customize the widths that "switch-preset-column-width" (Mod+R) toggles between.
    preset-column-widths {
        // Proportion sets the width as a fraction of the output width, taking gaps into account.
        // The default preset widths are 1/3, 1/2 and 2/3 of the output.
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // You can change the default width of the new windows.
    default-column-width { proportion 0.5; }

    // You can change how the focus ring looks.
    focus-ring {
        // How many logical pixels the ring extends out from the windows.
        width 4

        // Color of the ring on the active monitor.
        active-color "#7fc8ff"

        // Color of the ring on inactive monitors.
        inactive-color "#505050"
    }

    // You can also add a border. It's similar to the focus ring, but always visible.
    border {
        // The settings are the same as for the focus ring.
        // If you enable the border, you probably want to disable the focus ring.
        off

        width 4
        active-color "#ffc87f"
        inactive-color "#505050"

        // Color of the border around windows that request your attention.
        urgent-color "#9b0000"
    }

    // You can enable drop shadows for windows.
    shadow {
        // (Stock keeps shadows off; the dms/colors.kdl include may turn
        // them on with palette colors — leave this block stock.)

        // Softness controls the shadow blur radius.
        softness 30

        // Spread expands the shadow.
        spread 5

        // Offset moves the shadow relative to the window.
        offset x=0 y=5

        // You can also change the shadow color and opacity.
        color "#0007"
    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// DEVIATION (replaces stock's `spawn-at-startup "waybar"` — the bar is
// DMS, a user SERVICE, never spawned from here: two shell processes on
// one bus is breakage, so never `spawn-at-startup "dms" "run"` either).
// This one line is our half of the session lifecycle: it starts the anchor
// target that dms.service and friends are scoped to (home/niri.nix). niri
// runs startup spawns only after WAYLAND_DISPLAY
// is imported into the user manager, so everything the target pulls up sees
// the display — the ordering hyprland needed a two-command sh -c dance for.
// Teardown is native: niri.service BindsTo graphical-session.target.
spawn-at-startup "systemctl" "--user" "start" "niri-session.target"

hotkey-overlay {
    // Stock shows the "Important Hotkeys" pop-up at startup — KEPT while
    // learning the default keymap. Uncomment to turn it off later.
    // skip-at-startup
}

// DEVIATION (uncommented from stock): ask clients to omit client-side
// decorations. Without it, windows that draw their own shadows/titlebars
// make niri treat them as arbitrarily-shaped — borders and the focus ring
// render as a solid rectangle BEHIND the window instead of around it,
// which breaks the palette border theming. Restart apps after toggling.
prefer-no-csd

// You can change the path where screenshots are saved (used by niri's own
// screenshot actions; our Print binds go through screenshot-annotate —
// `dms screenshot` → satty, home/satty.nix — instead).
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Animation settings — STOCK.
// The wiki explains how to configure individual animations:
// https://niri-wm.github.io/niri/Configuration:-Animations
animations {
}

// Window rules let you adjust behavior for individual windows.
// https://niri-wm.github.io/niri/Configuration:-Window-Rules
// (Stock's wezterm/firefox example rules are dropped — neither app is
// installed here; dead config is the enemy.)

// DEVIATION: DMS's own windows (Settings, process list) float instead of
// tiling into a column. The app-id is set by shell.qml's
// `pragma AppId com.danklinux.dms` — verified in the pinned 1.5.3 source
// (older docs still say org.quickshell; sanity-check with
// `niri msg windows` while Settings is open if this ever stops matching).
window-rule {
    match app-id=r#"^com\.danklinux\.dms$"#
    open-floating true
}

// DEVIATION: the trigger half of on-demand VRR. Setting an output to
// `variable-refresh-rate on-demand=true` (Settings → Displays, per screen)
// only arms it — niri then switches the panel into VRR while a window
// matching a rule like this one is on it. Carried over from the PC's old
// per-host file when display config moved into DMS's GUI: the output half
// is now machine-local, this half isn't machine-specific at all, and it's
// inert on a machine whose outputs have no on-demand VRR armed.
window-rule {
    match app-id=r#"^steam_app_"#
    match app-id=r#"^mpv$"#
    variable-refresh-rate true
}

// DEVIATION: let DMS's wallpaper layer render inside niri's overview
// backdrop (the zoomed-out Mod+O view) — upstream's documented rule for
// running DMS on niri.
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

binds {
    // Keys consist of modifiers separated by + signs, followed by an XKB key name
    // in the end. To find an XKB name for a particular key, you may use a program
    // like wev.
    //
    // "Mod" is a special modifier equal to Super when running on a TTY, and to Alt
    // when running as a winit window.
    //
    // Most actions that you can bind here can also be invoked programmatically with
    // `niri msg action do-something`.

    // Mod-Shift-/, which is usually the same as Mod-?,
    // shows a list of important hotkeys.
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Suggested binds for running programs: terminal, app launcher, screen locker.
    Mod+T hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    // DEVIATION (command only, stock key): the launcher is DMS's spotlight,
    // not fuzzel — one shell, no second launcher.
    Mod+D hotkey-overlay-title="Run an Application" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    // DEVIATION (command only, stock key): the locker is DMS's, not
    // swaylock (which isn't installed).
    Super+Alt+L hotkey-overlay-title="Lock the Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }

    // DEVIATION: the DMS shell panels, on keys stock niri leaves free —
    // the same keys every shell era has used (do NOT adopt DMS's default
    // keymap; these binds are ours). Interaction is `dms ipc call <target>
    // <fn>` (`dms ipc list` enumerates everything). Not ported: the
    // window-switcher binds (Mod+Tab/Mod+O in the hyprland era) — niri's
    // own overview on Mod+O covers that natively, with type-to-launch.
    Mod+X hotkey-overlay-title="Power Menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+N hotkey-overlay-title="Control Center" { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Mod+Y hotkey-overlay-title="Wallpaper Picker" { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    // Mod+Comma is stock consume-window-into-column, so Settings moves to
    // Shift (the first niri era made the same call); clipboard likewise
    // yields Mod+V to stock toggle-window-floating and lands on Mod+P.
    Mod+Shift+Comma hotkey-overlay-title="DMS Settings" { spawn "dms" "ipc" "call" "settings" "toggle"; }
    Mod+P hotkey-overlay-title="Clipboard History" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }

    // DEVIATION (commands only, stock keys + allow-when-locked): audio,
    // media, and brightness route through the shell so its OSD shows and
    // (PC) external monitors get DDC brightness (native in DMS — no
    // ddcutil shell-out). Steps are explicit arguments here, matching the
    // 5% every era used. Stock's XF86AudioStop is dropped: nothing binds
    // a stop verb and playerctl isn't installed.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute        allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "micmute"; }

    XF86AudioPlay        allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPause       allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev        allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }

    // The trailing "" is NOT a typo and NOT optional. Since DMS 1.5.3 the
    // brightness verbs are `increment(step, device)` — two parameters — and
    // quickshell's IPC layer enforces arity on every typed parameter, so a
    // one-argument call is rejected client-side by `dms` and the key does
    // nothing at all, silently (nothing reaches dms.service, nothing lands
    // in its journal). That's exactly how these binds sat broken. `audio`
    // is still one-argument, which is why the volume keys never noticed.
    // Empty device = "you pick": DMS falls through to getPreferredDevice(),
    // i.e. the device PINNED to the focused screen (Control Center →
    // brightness, a per-machine GUI step like the idle timeouts), else its
    // default. That's what keeps this file host-agnostic — a literal id
    // like "ddc:i2c-11" is an i2c BUS NUMBER, not a stable identifier, and
    // would be PC-only besides. On the thinkpad the same two lines find the
    // eDP backlight first, no host branch needed.
    XF86MonBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }

    // DEVIATION: keyboard layout us↔th on the key it's been on since the
    // sway era. With exactly two layouts, "next" IS the toggle — no
    // reverse bind (and see the xkb note above: no grp: option, ever).
    Ctrl+Space { switch-layout "next"; }

    // Open/close the Overview: a zoomed-out view of workspaces and windows.
    // You can also move the mouse into the top-left hot corner,
    // or do a four-finger swipe up on a touchpad.
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // Alternative commands that move across workspaces when reaching
    // the first or last window in a column.
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // You can bind mouse wheel scroll ticks using the following syntax.
    // These binds will change direction based on the natural-scroll setting.
    //
    // To avoid scrolling through workspaces really fast, you can use
    // the cooldown-ms property. The bind will be rate-limited to this value.
    // You can set a cooldown on any bind, but it's most useful for the wheel.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Usually scrolling up and down with Shift in applications results in
    // horizontal scrolling; these binds replicate that.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // You can refer to workspaces by index. However, keep in mind that
    // niri is a dynamic workspace system, so these commands are kind of
    // "best effort". Trying to refer to a workspace index bigger than
    // the current workspace count will instead refer to the bottommost
    // (empty) workspace.
    //
    // For example, with 2 workspaces + 1 empty, indices 3, 4, 5 and so on
    // will all refer to the 3rd workspace.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // The following binds move the focused window in and out of a column.
    // If the window is alone, they will consume it into the nearby column to the side.
    // If the window is already in a column, they will expel it out.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consume one window from the right to the bottom of the focused column.
    Mod+Comma  { consume-window-into-column; }
    // Expel the bottom window from the focused column to the right.
    Mod+Period { expel-window-from-column; }

    // Cycle through widths set in preset-column-widths.
    Mod+R { switch-preset-column-width; }
    // Cycling through the presets in reverse order is also possible.
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // While maximize-column leaves gaps and borders around the window,
    // maximize-window-to-edges doesn't: the window expands to the edges of the screen.
    Mod+M { maximize-window-to-edges; }

    // Expand the focused column to space not taken up by other fully visible columns.
    // Makes the column "fill the rest of the space".
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    // Center all fully visible columns on screen.
    Mod+Ctrl+C { center-visible-columns; }

    // Finer width adjustments.
    // This command can also:
    // * set width in pixels: "1000"
    // * adjust width in pixels: "-5" or "+5"
    // * set width as a percentage of screen width: "25%"
    // * adjust width as a percentage of screen width: "-10%" or "+10%"
    // Pixel sizes use logical, or scaled, pixels.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Finer height adjustments when in column with other windows.
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Move the focused window between the floating and the tiling layout.
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Toggle tabbed column display mode.
    // Windows in this column will appear as vertical tabs,
    // rather than stacked on top of each other.
    Mod+W { toggle-column-tabbed-display; }

    // DEVIATION (commands only, stock keys): screenshots go through the
    // screenshot-annotate wrapper (home/satty.nix) — DMS's screenshot UI
    // captures, satty annotates; Enter commits (clipboard + file), Escape
    // discards, nothing touches disk or clipboard before satty. niri's own
    // screenshot UI is bypassed so the satty flow survives shell swaps.
    // Stock's Alt+Print screenshot-window stays dropped on purpose (the
    // wrapper's `window` mode exists, but drawing the region has been the
    // call since the hyprland era).
    Print { spawn "screenshot-annotate"; }
    Ctrl+Print { spawn "screenshot-annotate" "full"; }

    // Applications such as remote-desktop clients and software KVM switches may
    // request that niri stops processing the keyboard shortcuts defined here
    // so they may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor,
    // so a buggy application can't hold your session hostage.
    //
    // The allow-inhibiting=false property can be applied to other binds as well,
    // which ensures niri always processes them, even when an inhibitor is active.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // The quit action will show a confirmation dialog to avoid accidental exits.
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // Powers off the monitors. To turn them back on, do any input like
    // moving the mouse or pressing any other key.
    Mod+Shift+P { power-off-monitors; }
}

// ── DMS's generated fragments ───────────────────────────────────────────
// Everything DMS writes into ~/.config/niri/dms/ — machine-local,
// untracked, DO-NOT-EDIT generated files. LAST on purpose: includes merge
// last-wins, so these override the stock values set above (the palette
// beats the fallback focus-ring/border colors, outputs.kdl is the only
// place `output` blocks exist at all). Our keybinds are NOT among them —
// they live in THIS file, and dms/binds.kdl stays deliberately unused.
//
// EVERY one of these is optional=true, and that is load-bearing: a missing
// NON-optional include fails the WHOLE config, dropping niri to its
// built-in defaults — which on a fresh install is a deadlock, because the
// built-in defaults have no `spawn-at-startup niri-session.target`, so
// dms.service never starts, so the fragments never get written. Never add
// a DMS fragment here without optional=true.
//
//   colors.kdl      — matugen, rewritten on every wallpaper change
//   layout.kdl      — gaps/border/radius, from Settings → Compositor
//   windowrules.kdl — from Settings → Window Rules
//   outputs.kdl     — mode/scale/position/VRR, from Settings → Displays
//
// Careful with the path spelling of the last three: DMS greps for the
// literal `"dms/outputs.kdl"` to decide whether its own config is wired
// up, and re-appends its own include line (writing THROUGH this file's
// out-of-store symlink, straight into the repo) if it doesn't find it.
// A ~-expanded path would not match. optional=true does.
include optional=true "~/.config/niri/dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/windowrules.kdl"
include optional=true "dms/outputs.kdl"
